{
 "server": "github-official",
 "description": "Example for the GitHub MCP server: pushes, merges and file writes keyed by repo/branch or repo/path",
 "consume": [
  {
   "tool": "push_files",
   "resource": "{owner}/{repo}/{branch}"
  },
  {
   "tool": "create_or_update_file",
   "resource": "{owner}/{repo}/{branch}/{path}",
   "version": {
    "arg": "sha"
   },
   "note": "GitHub requires the previous blob sha: that IS the version"
  },
  {
   "tool": "merge_pull_request",
   "resource": "{owner}/{repo}/pr/{pull_number}"
  },
  {
   "tool": "create_branch",
   "resource": "{owner}/{repo}/{branch}"
  },
  {
   "tool": "delete_file",
   "resource": "{owner}/{repo}/{branch}/{path}",
   "version": {
    "arg": "sha"
   }
  }
 ],
 "release": []
}